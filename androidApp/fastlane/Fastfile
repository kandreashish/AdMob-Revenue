default_platform(:android)

platform :android do
  desc "Deploy a new version to Google Play Production track"
  lane :deploy do |options|
    status = options[:status] || "completed"
    upload_to_play_store(
      track: "production",
      aab: File.expand_path("../build/outputs/bundle/release/androidApp-release.aab", __dir__),
      release_status: status,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Deploy to Internal testing track"
  lane :internal do
    upload_to_play_store(
      track: "internal",
      aab: File.expand_path("../build/outputs/bundle/release/androidApp-release.aab", __dir__),
      release_status: "completed",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote or deploy to Closed testing track"
  lane :closed do |options|
    upload_to_play_store(
      track: "production",
      track_promote_to: options[:track] || "alpha",
      track_promote_release_status: options[:status] || "draft",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Validate upload against Google Play"
  lane :validate do
    upload_to_play_store(
      track: "production",
      aab: File.expand_path("../build/outputs/bundle/release/androidApp-release.aab", __dir__),
      release_status: "draft",
      validate_only: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
